<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
	<flow name="get-customers-flow" doc:id="e1522d22-7c27-430a-9f1f-63979cf520eb" >
		<http:listener doc:name="Listener" doc:id="d6aa0beb-b5f8-4c6e-a795-97250b492b3d" allowedMethods="POST" config-ref="HTTP_Listener_config" path="/api/customers">
			<http:response statusCode="#[vars.httpstatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<ee:transform doc:name="List Customers" doc:id="3183bcd1-3f72-4e02-8a3d-3c99fdbe6e04" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var customers = readUrl("classpath://data/customers.json", "application/json")
var city = attributes.queryParams.city
---
if (isEmpty(city)) customers
else customers filter ((customer) -> lower(customer.city) == lower(city))]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
	<flow name="get-customer-by-id-flow" doc:id="6abf0e62-8dde-42c1-8629-5d7d350be98f" >
		<http:listener doc:name="Listener" doc:id="1be16e0e-9d55-4b4e-9d8b-72b6dad07a33" config-ref="HTTP_Listener_config" path="/api/customers/{id}" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[attributes.uriParams.id]" doc:name="customerId" doc:id="99d09590-d24a-4f90-a589-b47dd176f775" variableName="Save customer ID"/>
		<ee:transform doc:name="Find Customer" doc:id="7e846c68-654e-4255-a4f2-134a1ce08195" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
var customers = readUrl("classpath://data/customers.json", "application/json")
---
(customers filter ((customer) -> customer.id == vars.customerId))[0]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Customer found?" doc:id="e208cb1e-05ee-4d3b-a6a3-e20509d8f586" >
			<when expression="#[payload == null]">
				<raise-error doc:name="Not found" doc:id="768613b5-40ef-4d07-b720-d7e8639c4f1a" type="CUSTOMER:NOT_FOUND" description="'Customer ' ++ vars.customerId ++ 'not found'"/>
			</when>
			<otherwise >
				<ee:transform doc:name="Customer to JSON" doc:id="c9cd4bab-24d7-4fcc-a578-aa264bc0baf4">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
			</otherwise>
		</choice>
	</flow>
	<flow name="customer-apiFlow2" doc:id="abce9423-4240-42d6-a7ee-64362ffe6245" >
		<http:listener doc:name="Listener" doc:id="e8a96230-a523-4f07-93d5-a62daf41a0aa" config-ref="HTTP_Listener_config" path="/api/customers" allowedMethods="POST"/>
		<ee:transform doc:name="Transform Message" doc:id="ed2d98bf-20b2-49d1-ad2a-6f2ad225a92c" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<choice doc:name="Choice" doc:id="9685ea26-8491-4d3d-93e3-7b884618d5b1" >
			<when />
			<otherwise >
				<raise-error doc:name="Raise error" doc:id="38713f77-2a08-4216-939a-604f6aa505e1" type="CUSTOMER:INVALID_REQUEST"/>
			</otherwise>
		</choice>
		<set-variable value="" doc:name="Set Variable" doc:id="6f3d9c60-96bb-4bfa-ba76-3dd6cee67d2b" />
		<ee:transform doc:name="Transform Message" doc:id="99095439-a73d-4a5c-8c9c-915cbfd9b2b6" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="missingFields" ><![CDATA[%dw 2.0
output application/java
var requriedFields = ["firstName", "lastName", "email"]
---
requiredFields filter ((field) -> isEmpty(payload[field]))]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
	</flow>
</mule>
